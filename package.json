{
  "name": "@allowly/mcp",
  "version": "0.1.2",
  "description": "Allowly guardrail middleware for MCP tool calls",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external @allowly/sdk --external @modelcontextprotocol/sdk",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build && node --input-type=module -e \"const pkg = await import('@allowly/mcp'); if (typeof pkg.AllowlyMCPMiddleware !== 'function') process.exit(1)\""
  },
  "peerDependencies": {
    "@allowly/sdk": "^0.1.2",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@allowly/sdk": "^0.1.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^20.19.40",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
