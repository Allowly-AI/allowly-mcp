{
  "name": "@allowly/mcp",
  "version": "0.3.0",
  "description": "Allowly guardrail middleware for MCP tool calls",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --external @allowly/sdk --external @modelcontextprotocol/sdk && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build && node --input-type=module -e \"const pkg = await import('@allowly/mcp'); if (typeof pkg.AllowlyMCPMiddleware !== 'function') process.exit(1)\""
  },
  "peerDependencies": {
    "@allowly/sdk": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@allowly/sdk": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^20.19.40",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Allowly-AI/allowly-mcp.git"
  },
  "license": "MIT"
}
